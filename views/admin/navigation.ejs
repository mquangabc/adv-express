<!-- Sidebar Navigation Partial -->
<div class="col-md-3 col-lg-2 sidebar p-3">
  <!-- User Profile -->
  <div class="text-center mb-4">
    <% if (user && user.avatar) { %>
      <img src="/uploads/<%= user.avatar %>" alt="Avatar" class="profile-avatar rounded-circle mb-2">
      <% } else { %>
        <div
          class="profile-avatar rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-2">
          <i class="fas fa-user text-muted fa-2x"></i>
        </div>
        <% } %>
          <h6 class="mb-1">
            <%= user ? user.username : 'User' %>
          </h6>
          <small class="text-white-50">
            <%= user ? user.email : '' %>
          </small>
  </div>

  <!-- Navigation -->
  <nav class="nav flex-column">
    <a class="nav-link" href="/dashboard" data-page="dashboard">
      <i class="fas fa-tachometer-alt me-2"></i>Dashboard
    </a>
    <a class="nav-link" href="/profile" data-page="profile">
      <i class="fas fa-user me-2"></i>Profile
    </a>
    <a class="nav-link" href="/user" data-page="user">
      <i class="fas fa-folder me-2"></i>User
    </a>
    <hr class="my-3">
    <a class="nav-link" href="/logout">
      <i class="fas fa-sign-out-alt me-2"></i>Logout
    </a>
  </nav>
</div>
