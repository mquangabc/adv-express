<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> - Node TypeScript Server
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .navbar-brand {
      font-weight: bold;
    }

    .hero-section {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 100px 0;
    }

    .feature-card {
      transition: transform 0.2s;
    }

    .feature-card:hover {
      transform: translateY(-5px);
    }
  </style>
</head>

<body>
  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">🚀 Node TS Server</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/api/users">Users API</a>
          </li>
        </ul>
        <ul class="navbar-nav">
          <% if (user) { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                👋 <%= user.username %>
              </a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/dashboard">Dashboard</a></li>
                <li><a class="dropdown-item" href="/profile">Profile</a></li>
                <li>
                  <hr class="dropdown-divider">
                </li>
                <li><a class="dropdown-item" href="/auth/logout">Logout</a></li>
              </ul>
            </li>
            <% } else { %>
              <li class="nav-item">
                <a class="nav-link" href="/auth/login">Login</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/auth/register">Register</a>
              </li>
              <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <div class="hero-section">
    <div class="container text-center">
      <h1 class="display-4 mb-4">Welcome to Node TypeScript Server</h1>
      <p class="lead mb-5">A powerful, secure, and feature-rich backend server built with TypeScript, Express, and
        PostgreSQL</p>
      <div class="row">
        <div class="col-md-3">
          <div class="text-center">
            <div class="h1">🔐</div>
            <h5>JWT Authentication</h5>
          </div>
        </div>
        <div class="col-md-3">
          <div class="text-center">
            <div class="h1">📁</div>
            <h5>File Upload</h5>
          </div>
        </div>
        <div class="col-md-3">
          <div class="text-center">
            <div class="h1">🗄️</div>
            <h5>PostgreSQL</h5>
          </div>
        </div>
        <div class="col-md-3">
          <div class="text-center">
            <div class="h1">⚡</div>
            <h5>TypeScript</h5>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Features Section -->
  <div class="container my-5">
    <div class="row">
      <div class="col-lg-12 text-center mb-5">
        <h2>Features</h2>
        <p class="text-muted">Everything you need to build a modern web application</p>
      </div>
    </div>
    <div class="row">
      <div class="col-md-4 mb-4">
        <div class="card h-100 feature-card">
          <div class="card-body text-center">
            <div class="h1 text-primary">🛡️</div>
            <h5 class="card-title">Security</h5>
            <p class="card-text">JWT tokens, bcrypt password hashing, CORS protection, rate limiting, and
              helmet security headers.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="card h-100 feature-card">
          <div class="card-body text-center">
            <div class="h1 text-success">🔄</div>
            <h5 class="card-title">Session Management</h5>
            <p class="card-text">Express sessions with cookie support for both stateful and stateless
              authentication.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="card h-100 feature-card">
          <div class="card-body text-center">
            <div class="h1 text-info">📊</div>
            <h5 class="card-title">Database</h5>
            <p class="card-text">PostgreSQL with Knex.js query builder, migrations, and connection pooling.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- API Testing Section -->
  <div class="bg-light py-5">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 text-center mb-4">
          <h3>API Endpoints</h3>
          <p class="text-muted">Test the API endpoints directly from your browser or API client</p>
        </div>
      </div>
      <div class="row">
        <div class="col-md-6">
          <h5>Authentication</h5>
          <ul class="list-group">
            <li class="list-group-item d-flex justify-content-between">
              <span><code>POST /api/auth/register</code></span>
              <span class="badge bg-primary">Register</span>
            </li>
            <li class="list-group-item d-flex justify-content-between">
              <span><code>POST /api/auth/login</code></span>
              <span class="badge bg-success">Login</span>
            </li>
            <li class="list-group-item d-flex justify-content-between">
              <span><code>POST /api/auth/logout</code></span>
              <span class="badge bg-warning">Logout</span>
            </li>
            <li class="list-group-item d-flex justify-content-between">
              <span><code>GET /api/auth/me</code></span>
              <span class="badge bg-info">Profile</span>
            </li>
          </ul>
        </div>
        <div class="col-md-6">
          <h5>File Upload</h5>
          <ul class="list-group">
            <li class="list-group-item d-flex justify-content-between">
              <span><code>POST /api/upload/single</code></span>
              <span class="badge bg-primary">Single File</span>
            </li>
            <li class="list-group-item d-flex justify-content-between">
              <span><code>POST /api/upload/multiple</code></span>
              <span class="badge bg-success">Multiple Files</span>
            </li>
            <li class="list-group-item d-flex justify-content-between">
              <span><code>GET /api/upload/file/:filename</code></span>
              <span class="badge bg-info">Get File</span>
            </li>
            <li class="list-group-item d-flex justify-content-between">
              <span><code>DELETE /api/upload/file/:filename</code></span>
              <span class="badge bg-danger">Delete File</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Login Modal -->
  <div class="modal fade" id="loginModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Login</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="loginForm">
            <div class="mb-3">
              <label for="loginEmail" class="form-label">Email</label>
              <input type="email" class="form-control" id="loginEmail" required>
            </div>
            <div class="mb-3">
              <label for="loginPassword" class="form-label">Password</label>
              <input type="password" class="form-control" id="loginPassword" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">Login</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Register Modal -->
  <div class="modal fade" id="registerModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Register</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="registerForm">
            <div class="mb-3">
              <label for="registerUsername" class="form-label">Username</label>
              <input type="text" class="form-control" id="registerUsername" required>
            </div>
            <div class="mb-3">
              <label for="registerEmail" class="form-label">Email</label>
              <input type="email" class="form-control" id="registerEmail" required>
            </div>
            <div class="mb-3">
              <label for="registerPassword" class="form-label">Password</label>
              <input type="password" class="form-control" id="registerPassword" required>
            </div>
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="registerFirstName" class="form-label">First Name</label>
                  <input type="text" class="form-control" id="registerFirstName">
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="registerLastName" class="form-label">Last Name</label>
                  <input type="text" class="form-control" id="registerLastName">
                </div>
              </div>
            </div>
            <button type="submit" class="btn btn-success w-100">Register</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-dark text-white text-center py-4 mt-5">
    <div class="container">
      <p>&copy; 2024 Node TypeScript Server. Built with ❤️ using TypeScript, Express, and PostgreSQL.</p>
    </div>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Login form handler

  </script>
</body>

</html>